{
    "name": "monkeyscloud/monkeyslegion-ssh",
    "description": "Native PHP SSH utility library with fluent API for PHP 8.4+",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "ext-ssh2": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\SSH\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse src tests",
        "psalm": "psalm",
        "cs-fix": "php-cs-fixer fix src tests",
        "cs-check": "php-cs-fixer check src tests"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
