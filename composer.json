{
    "name": "monkeyscloud/monkeyslegion-ssh",
    "description": "Native PHP 8.4+ SSH library with fluent API — SFTP, SCP, command pipelines, and connection management. Wraps ext-ssh2 with full type safety (PHPStan level 9).",
    "type": "library",
    "license": "MIT",
    "readme": "README.md",
    "keywords": [
        "ssh",
        "sftp",
        "scp",
        "ssh2",
        "remote-command",
        "server-management",
        "deployment",
        "php8.4",
        "ssh-client",
        "php-ssh"
    ],
    "homepage": "https://github.com/monkeyscloud/monkeyslegion-ssh",
    "support": {
        "issues": "https://github.com/monkeyscloud/monkeyslegion-ssh/issues",
        "source": "https://github.com/monkeyscloud/monkeyslegion-ssh"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/monkeyscloud"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-ssh2": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "infection/infection": "^0.34.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "ext-sockets": "For advanced socket operations in SSH connections"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\SSH\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "test": "phpunit --colors=always --no-coverage",
        "test:coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html .build/coverage --coverage-text",
        "phpstan": "phpstan analyse --ansi",
        "psalm": "psalm --no-cache",
        "infection": "XDEBUG_MODE=coverage php -d zend.assertions=1 vendor/bin/infection --threads=4 --no-progress",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.php --ansi",
        "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --ansi",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "pre-commit": [
            "@cs-fix",
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "quality-report": "php scripts/quality-report.php"
    }
}
