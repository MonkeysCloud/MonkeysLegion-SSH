# SSH Connection Configuration
# These values are used for testing and configuration

# Integration test server (Docker)
INTEGRATION_SSH_HOST=127.0.0.1
INTEGRATION_SSH_PORT=2222
INTEGRATION_SSH_USERNAME=integration
INTEGRATION_SSH_PASSWORD=integration-password

# Default production connection
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USERNAME=forge
SSH_AUTH=key
SSH_PRIVATE_KEY=/home/user/.ssh/id_rsa
SSH_PASSPHRASE=
SSH_TIMEOUT=30

# Enable integration tests (1 = enabled, 0 = disabled)
RUN_INTEGRATION_TESTS=0